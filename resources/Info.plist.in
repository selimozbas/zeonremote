<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>Zeon Remote</string>
  <key>CFBundleExecutable</key>
  <string>ZeonRemote</string>
  <key>CFBundleIconFile</key>
  <string>@ZV_ICON_FILE@</string>
  @ZV_ICON_NAME_ENTRY@
  <key>CFBundleIdentifier</key>
  <string>com.zeonvnc.viewer</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>Zeon Remote</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@PROJECT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@PROJECT_VERSION@</string>
  <key>LSMinimumSystemVersion</key>
  <string>@CMAKE_OSX_DEPLOYMENT_TARGET@</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.utilities</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSPrincipalClass</key>
  <string>ZVApplication</string>
  <key>NSHumanReadableCopyright</key>
  <string>© 2026 Selim Ozbas and contributors. GNU General Public License v2 or later.</string>
  @ZV_SPARKLE_ENTRIES@
  <key>NSLocalNetworkUsageDescription</key>
  <string>Zeon Remote connects to computers and devices on your local network.</string>
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>VNC URL</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>vnc</string>
      </array>
    </dict>
  </array>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>VNC Connection File</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.zeonvnc.connection</string>
      </array>
    </dict>
  </array>
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.zeonvnc.connection</string>
      <key>UTTypeDescription</key>
      <string>VNC Connection File</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>vnc</string>
        </array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
